# ======================= FATUCCI BREAKFAST BOT =======================
# Файл необязателен: всё это можно задать переменными окружения
# в панели хостинга. Переменные окружения имеют приоритет над этим файлом.
#
# Обязателен ровно один параметр — TELEGRAM_TOKEN.
# Всё остальное настраивается уже внутри бота: команда /admin.

# --- ЕДИНСТВЕННОЕ, ЧТО НУЖНО ОБЯЗАТЕЛЬНО ---
# Токен бота от @BotFather. Подойдёт и имя BOT_TOKEN — панели хостингов часто
# используют именно его.
TELEGRAM_TOKEN=123456:AAAA-BBBB-CCCC


# ================== ДАЛЬШЕ — ВСЁ НЕОБЯЗАТЕЛЬНО ==================

# Username бота без @. Если не задать — бот определит его сам при запуске.
# Нужен только для ссылок в QR-кодах.
TELEGRAM_BOT_USERNAME=

# Аварийный доступ к админ-панели.
# Обычно НЕ НУЖЕН: владельцем автоматически становится первый, кто написал боту,
# а остальных менеджеров он добавляет в /admin -> 👑 Доступ.
# Заполните, только если потеряли доступ и нужно вернуть его принудительно.
ADMIN_IDS=

# Рабочий чат для заказов. Обычно задаётся в /admin -> ⚙️ Настройки.
# Узнать ID: добавьте бота в чат и отправьте там /id
ORDERS_CHAT_ID=

# MAX подключается в /admin -> 📱 Каналы: достаточно вставить токен,
# username бот определит сам. Эти переменные — запасной путь,
# если удобнее задать их на хостинге.
MAX_TOKEN=
MAX_BOT_USERNAME=

# Оплата: токен платёжного провайдера (PayMaster) от @BotFather.
# Обычно вводится в /admin -> 💳 Оплата, здесь — необязательно.
# Формат: 123456789:TEST:abcdef…   (TEST — тестовый режим, LIVE — боевой)
PAYMENT_PROVIDER_TOKEN=

# Часовой пояс: смещение от UTC в часах. Москва/Сочи = 3
TZ_OFFSET=3

# --- База данных ---
# Задан DATABASE_URL — бот работает с PostgreSQL (всё состояние там).
# Пусто — используется локальный файл SQLite по пути DB_PATH.
# На bothost адрес базы выдаётся в панели: postgresql://логин:пароль@хост:порт/база
DATABASE_URL=
# Необязательно: схема PostgreSQL, если база общая с другими проектами
DB_SCHEMA=

# Путь к файлу SQLite (используется, только если DATABASE_URL пуст)
DB_PATH=data/bot.db
LOG_LEVEL=INFO
