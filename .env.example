# ======================= FATUCCI BREAKFAST BOT =======================
# Скопируйте этот файл в .env и заполните значения.
# Всё остальное настраивается уже внутри бота: /admin

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_TOKEN=123456:AAAA-BBBB-CCCC
# Username бота без @ (нужен для QR-ссылок вида t.me/username?start=...)
TELEGRAM_BOT_USERNAME=fatucci_breakfast_bot

# --- MAX (max.ru) ---
# Токен бота из MasterBot в MAX. Можно оставить пустым и подключить MAX позже
# (тогда бот работает только в Telegram, а включить MAX можно в /admin -> Настройки).
MAX_TOKEN=
# Username бота в MAX без @ (для QR-ссылок вида max.ru/username?start=...)
MAX_BOT_USERNAME=

# --- Администраторы ---
# Telegram user_id через запятую. Узнать свой id можно у @userinfobot.
ADMIN_IDS=123456789

# --- Рабочий чат для заказов ---
# ID группы/канала Telegram, куда падают все заказы (обязательно с минусом, напр. -1001234567890).
# Можно оставить пустым и задать позже в /admin -> Настройки.
ORDERS_CHAT_ID=

# --- Часовой пояс (смещение от UTC в часах). Москва/Сочи = 3 ---
TZ_OFFSET=3

# --- ЮKassa (онлайн-оплата) ---
# Можно оставить пустыми и ввести позже в /admin -> Оплата.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Прочее ---
# Путь к файлу базы данных
DB_PATH=data/bot.db
# Уровень логов: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
